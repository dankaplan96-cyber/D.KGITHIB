[
  { "$schema": "../job.schema.json", "op": "import", "name": "chest: baseline into a working .blend",
    "input": "art/blender/props/chest_honey/source/chest_honey.polyprop.json",
    "blend": "art/blender/props/chest_honey/work/chest_honey.blend" },
  { "op": "inspect", "name": "chest: baseline report",
    "input": "art/blender/props/chest_honey/source/chest_honey.polyprop.json",
    "output": "art/blender/props/chest_honey/reports/baseline.inspect.json" },
  { "op": "validate", "name": "chest: working .blend checks",
    "input": "art/blender/props/chest_honey/work/chest_honey.blend",
    "output": "art/blender/props/chest_honey/reports/work.validate.json",
    "options": { "target": "polyprop", "sizeTolerance": 0.005, "maxMaterials": 4, "maxTriangles": 4000 } },
  { "op": "preview", "name": "chest: working .blend views",
    "input": "art/blender/props/chest_honey/work/chest_honey.blend",
    "output": "art/blender/props/chest_honey/previews/work",
    "options": { "resolution": 384, "modes": ["neutral", "textured"] } },
  { "op": "export", "name": "chest: candidate for the game",
    "input": "art/blender/props/chest_honey/work/chest_honey.blend",
    "output": "art/blender/props/chest_honey/export/chest_honey.candidate.polyprop.json",
    "options": { "format": "polyprop" } },
  { "op": "export", "name": "chest: glTF copy (interchange only)",
    "input": "art/blender/props/chest_honey/work/chest_honey.blend",
    "output": "art/blender/props/chest_honey/export/chest_honey.candidate.glb",
    "options": { "format": "glb" } },
  { "op": "inspect", "name": "chest: candidate report",
    "input": "art/blender/props/chest_honey/export/chest_honey.candidate.polyprop.json",
    "output": "art/blender/props/chest_honey/reports/candidate.inspect.json" },
  { "op": "validate", "name": "chest: candidate checks",
    "input": "art/blender/props/chest_honey/export/chest_honey.candidate.polyprop.json",
    "output": "art/blender/props/chest_honey/reports/candidate.validate.json",
    "options": { "target": "polyprop", "sizeTolerance": 0.005, "maxMaterials": 4, "maxTriangles": 4000 } }
]
