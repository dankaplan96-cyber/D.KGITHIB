diff --git a/lba3/src/game/story/hometap.js b/lba3/src/game/story/hometap.js
index ce81a756..18c2faaf 100644
--- a/lba3/src/game/story/hometap.js
+++ b/lba3/src/game/story/hometap.js
@@ -330,3 +330,170 @@ export class HomeTap {
   }
 }
 
+// ================================================================ the epilogue: the tap again (CAMPAIGN-10)
+// The treatment's "playable aftermath" (CAMPAIGN-STRENGTHEN.md, wave 8): chapter 1's household problem (the dry tap,
+// Arthur's cup, the knocking in the kitchen wall) closes in Twinsen's own hands. After the dinner the player has the
+// kitchen: Arthur has gone to the sink to listen to the pipe (he counted its knocking in chapters 10 and 12); Twinsen
+// turns the tap's handle himself, the water runs cold into Arthur's cup under the spout, and the wall stays quiet. Arthur
+// keeps his cup there "just in case". Then a word with Zoé, and the end screen. Short; not a quest.
+//
+// Flags (new, saved): ep_v (a game that came to the epilogue with this step: set as the epilogue begins, or on loading a
+// save from before at the epilogue's start, whose dinner is ahead), ep_tap (the tap turned), ep_word (Zoé's word: the end
+// screen follows). A save from before past the dinner has no ep_v: the step counts as done, and the tap is only a tap.
+// Not a chapter: story/epilogue.js owns it (`this.tap`) and asks it first.
+const TAP_CLIP = 'touchWater';                       // (his hand at 1.34 m: the handle's cross, interiors.js buildHouse)
+const TAP_A = Math.PI + Math.atan2(0.43, 0.59);      // (turned so the hand, ahead and to his right, reaches straight to the wall)
+export class EpilogueTap {
+  constructor(ch) { this.ch = ch; this.game = ch.game; this.story = ch.story; this.later = []; this.turn = null; this.flow = 0; this.flowTo = 0; this.fill = 0; this.busy = false; }
+  get f() { return this.game.flags; }
+  get home() { return this.story.chapters[0].home; }
+  get P() { return this.home?.parts?.house; }
+  get R() { return this.game.regions?.built?.('house'); }
+  // the step's game: it came to the epilogue with it
+  get on() { return !!this.f.ep_v && this.ch.on(); }
+  // the kitchen's moment: after the dinner, until Zoé's word
+  get open() { return this.on && !!this.f.ep_dinner && !this.f.ep_word; }
+  // in the house after the dinner: the tap is his to turn (the step, or afterwards in free play)
+  get usable() { return this.ch.on() && !!this.f.ep_dinner && this.game.room?.id === 'house' && !!this.P; }
+
+  // ---------------------------------------------------------------- where things are
+  // his hand on the cross's knob toward the room (the clip's hand at its height), stood at the cupboard's front
+  touch() { const K = this.P.K; return touch(K.knob.x, K.knob.z, TAP_A, TAP_CLIP); }
+  // Arthur's cup under the spout, clear of the watering can (house frame); the stream leans the last centimetres into it
+  underAt() {
+    const P = this.P, K = P.K, o = P.o, sx = K.spout.x - o.x, sz = K.spout.z - o.z, cx = K.can.x - o.x, cz = K.can.z - o.z;
+    const d = Math.hypot(sx - cx, sz - cz) || 1, ux = (sx - cx) / d, uz = (sz - cz) / d, R0 = K.can.r + 0.07;
+    return { x: cx + ux * R0, y: K.basin.y + 0.02, z: cz + uz * R0 };
+  }
+  // (the people's places for the dinner and after it: at the table's north side; after it Arthur by the sink, listening)
+  spots() {
+    const R = this.R, T = R?.table, K = this.P?.K; if (!T || !K) return null;
+    const ar = { x: K.basin.x + 1.25, z: K.basin.z + 0.85 };   // (by the dresser: a body clear of where he stands at the tap)
+    return {
+      hero: { x: T.x, z: T.z - 0.8, a: 0 },
+      zoe: { x: T.x + 0.85, z: T.z - 0.7, a: 0 },
+      arthur: { x: T.x - 0.85, z: T.z - 0.75, a: 0 },
+      arthurSink: { ...ar, a: Math.atan2(K.knob.x - ar.x, K.knob.z - ar.z) },
+    };
+  }
+
+  // ---------------------------------------------------------------- the things
+  build() {
+    const P = this.P; if (!P || P.cupWater) return;
+    // the water in Arthur's cup (rises as the tap runs; the stream's own material: no new program)
+    const w = new THREE.Mesh(new THREE.CircleGeometry(0.054, 14), P.K.stream.material);
+    w.rotation.x = -Math.PI / 2; w.position.y = 0.012; w.visible = false; P.cup.add(w);
+    P.cupWater = w;
+  }
+  // the kitchen as the step has it: the cup under the spout (in the epilogue), full once the tap has run; the stream off
+  setKitchen() {
+    this.build();
+    const P = this.P, f = this.f; if (!P) return;
+    const K = P.K, here = this.ch.on();
+    this.turn = null; this.flow = this.flowTo = 0; this.later = []; this.busy = false;
+    K.handle.rotation.y = 0;
+    K.stream.visible = false; K.stream.scale.set(1, 1, 1); K.stream.rotation.set(0, 0, 0);
+    K.stream.position.set(K.spout.x - P.o.x, K.spout.y, K.spout.z - P.o.z);
+    if (!here) { P.cupWater.visible = false; return; }
+    const u = this.underAt(); P.cup.position.set(u.x, u.y, u.z); P.cup.rotation.set(0, 2.4, 0); P.carry = false; P.putT = null;
+    this.fill = f.ep_tap ? 1 : 0; this.setFill();
+  }
+  setFill() { const W = this.P?.cupWater; if (!W) return; W.visible = this.fill > 0.02; W.position.y = 0.012 + 0.1 * this.fill; }
+  // the stream from the spout into the cup (it leans the few centimetres from the spout's mouth to the cup's middle)
+  aim() {
+    const P = this.P, K = P.K, u = this.underAt(), sx = K.spout.x - P.o.x, sz = K.spout.z - P.o.z;
+    const len = K.spout.y - (u.y + 0.11), dx = (u.x - sx) * 0.55, dz = (u.z - sz) * 0.55;
+    K.stream.rotation.set(Math.atan2(-dz, len), 0, Math.atan2(dx, len));
+    const full = K.spout.y - K.basin.y; K.stream.scale.set(1, Math.max(0.2, len / full), 1);
+  }
+
+  // ---------------------------------------------------------------- the story's hooks (epilogue.js asks first)
+  place(id) {
+    if (!this.on || this.f.ep_word) return undefined;
+    const S = this.spots(); if (!S) return undefined;
+    const after = !!this.f.ep_dinner;
+    if (id === 'zoe') return { ...S.zoe, anim: after ? 'wipe' : null };
+    if (id === 'arthur') return after ? { ...S.arthurSink, anim: null } : { ...S.arthur, anim: null };
+    return undefined;
+  }
+  // where he sits down to dinner (at the table, not in the doorway)
+  heroSpot() { return this.spots()?.hero ?? null; }
+  // after the dinner's last line: the kitchen is the player's
+  afterDinner() {
+    const g = this.game, ch = this.ch;
+    this.story.refreshCast({ walk: true });   // (Arthur off to the sink, Zoé clearing the table)
+    ch.chain([['narrator', 'ep_narr_after'], ['arthur', 'ep_ar_ask'], ['zoe', 'ep_zoe_ask']], () => { g.updateObjective(); g.save(false); });
+  }
+  canExit(room) {
+    if (!this.open || room?.id !== 'house') return true;
+    this.ch.chain([['hero', this.f.ep_tap ? 'ep_leave_zoe' : 'ep_leave_tap']]);
+    return false;
+  }
+  objective() {
+    if (!this.open) return null;
+    return this.f.ep_tap ? this.ch.goal('ep_obj_zoe') : this.ch.goal('ep_obj_tap');
+  }
+  journal() { return this.on && this.f.ep_tap ? [{ key: 'ep_j_tap', done: true }] : []; }
+  interactables(consider, dist) {
+    if (!this.usable || this.busy) return;
+    const K = this.P.K;
+    consider(dist(K.knob.x, K.knob.z), 1.3, { kind: 'ep_tap', label: 'p_turn' });
+  }
+  interact(it) {
+    if (it.kind !== 'ep_tap') return false;
+    const g = this.game, f = this.f, h = g.hero, ch = this.ch, P = this.P, K = P.K, first = this.open && !f.ep_tap;
+    this.busy = true;
+    // his hand on the knob; the handle turns under it and the water comes, cold, into Arthur's cup; the wall stays quiet
+    handTo(h, this.touch(), () => {
+      g.audio.play('valve', P.spout);
+      this.turn = { from: K.handle.rotation.y, to: -1.5, t: 0, d: 0.45 };
+      this.after(0.35, () => { this.aim(); this.flowTo = 1; g.audio.play('waterRun', P.spout); });
+      for (let i = 1; i < 4; i++) this.after(0.35 + i * 0.7, () => { if (this.flowTo > 0) g.audio.play('waterRun', P.spout); });
+      const lines = first ? [['hero', 'ep_tw_cold'], ['arthur', 'ep_ar_quiet'], ['arthur', 'ep_ar_case'], ['hero', 'ep_tw_case'], ['arthur', 'ep_ar_case2']] : [['hero', 'ep_tap_again']];
+      this.after(first ? 2.2 : 1.4, () => ch.chain(lines, () => this.shut(first)));
+    });
+    return true;
+  }
+  // he shuts it again (his hand on the knob once more)
+  shut(first) {
+    const g = this.game, f = this.f, h = g.hero, P = this.P, K = P.K;
+    handTo(h, this.touch(), () => {
+      g.audio.play('valveShut', P.spout);
+      this.turn = { from: K.handle.rotation.y, to: 0, t: 0, d: 0.4 };
+      this.after(0.2, () => { this.flowTo = 0; });
+      this.after(0.6, () => {
+        this.busy = false;
+        if (first) { f.ep_tap = true; this.fill = 1; this.setFill(); g.updateObjective(); g.save(false); }
+      });
+    });
+  }
+  talk(npc) {
+    if (!this.open || this.game.room?.id !== 'house') return false;
+    const f = this.f, ch = this.ch, g = this.game, id = npc.def.id;
+    if (id === 'arthur') { ch.chain([['arthur', f.ep_tap ? 'ep_ar_after' : 'ep_ar_wait']]); return true; }
+    if (id !== 'zoe') return false;
+    if (!f.ep_tap) { ch.chain([['zoe', 'ep_zoe_tapfirst']]); return true; }
+    // the word, then the end screen
+    ch.chain([['zoe', 'ep_zoe_w1'], ['hero', 'ep_tw_w1'], ['zoe', 'ep_zoe_w2'], ['hero', 'ep_tw_w2'], ['zoe', 'ep_zoe_w3']], () => {
+      f.ep_word = true; g.save(false); ch.showEnd();
+    });
+    return true;
+  }
+
+  // ---------------------------------------------------------------- what moves
+  after(t, fn) { this.later.push({ t, fn }); }
+  update(dt) {
+    const g = this.game, P = this.P;
+    if (this.later.length) { for (const l of this.later) l.t -= dt; const due = this.later.filter((l) => l.t <= 0); this.later = this.later.filter((l) => l.t > 0); for (const l of due) l.fn(); }
+    if (!P) return;
+    const K = P.K;
+    if (this.turn) { const T = this.turn; T.t += dt; const k = Math.min(1, T.t / T.d), e = k * k * (3 - 2 * k); K.handle.rotation.y = T.from + (T.to - T.from) * e; if (k >= 1) this.turn = null; }
+    if (this.flow !== this.flowTo) {
+      this.flow = this.flowTo > this.flow ? Math.min(this.flowTo, this.flow + dt / 0.25) : Math.max(this.flowTo, this.flow - dt / 0.2);
+      K.stream.visible = this.flow > 0.01; K.stream.scale.x = K.stream.scale.z = Math.max(0.05, this.flow);
+    }
+    if (this.flow > 0.5 && this.fill < 1) { this.fill = Math.min(1, this.fill + dt / 2.0); this.setFill(); }
+    if (this.flow > 0.5 && g.room === P.H && Math.random() < dt * 8) { P.cupWater.getWorldPosition(_v); g.particles.burst(_v.x, _v.y + 0.01, _v.z, '#cfe8ff', 1, 0.5); }
+  }
+}
