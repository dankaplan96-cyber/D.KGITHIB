diff --git a/lba3/tests/campaign-thread.mjs b/lba3/tests/campaign-thread.mjs
index 651c6b5c..b01c8768 100644
--- a/lba3/tests/campaign-thread.mjs
+++ b/lba3/tests/campaign-thread.mjs
@@ -980,7 +980,7 @@ if (!ONLY || ONLY === 'Q') {
   ({ browser, context, page } = await launch({ storageState: save('base-16') })); await open(page, '?nocine'); await menu(page, 'continue');
   is('Q1 a save from before wave 8 at the epilogue\'s start (before the dinner): it loads, the dinner plays again (it loaded into a quiet house before); after it the kitchen is his: the tap\'s objective, Arthur by the sink, the cup under the spout, empty', await ev(() => {
     const G = game, f = G.flags; for (let i = 0; i < 20 && G.state !== 'dialog'; i++) G.step(0.1);
-    const s0 = [f.ep_v ?? null, f.ep_dinner ?? null, G.state, document.querySelector('#dialog .text')?.textContent?.slice(0, 40) || ''];
+    const s0 = [f.ep_v ?? null, f.ep_dinner ?? null, G.state, (G.hud?.dialog?.full || document.querySelector('#dialog .text')?.textContent || '').slice(0, 40)];   // (the whole line: the box types it out)
     for (let i = 0; i < 100 && !(f.ep_dinner && G.state === 'play'); i++) { if (G.state === 'dialog') P.settle(); else G.step(0.1); }
     return s0; }).then(async (s0) => [...s0, await EP_STATE()]), (v) => v[0] === 1 && v[1] === null && v[2] === 'dialog' && /Four days later/.test(v[3]) && v[4].dinner === true && v[4].state === 'play' && v[4].room === 'house' && /tap/i.test(v[4].obj) && v[4].arthurSink < 2 && v[4].cupUnder < 0.01 && !v[4].cupFull);
   await shot('Q1-kitchen');
