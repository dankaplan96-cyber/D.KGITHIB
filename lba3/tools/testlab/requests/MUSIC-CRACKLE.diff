+// Shared paths for the crackle tools: Playwright and Electron from the Test Lab (lba3/tools/testlab, npm install there),
+// the game's URL (GAME_URL, as the tests; serve lba3/ first), and where runs are written (CRACKLE_RUNS, default the
+// system's temp folder: recordings are large and are never committed).
+import os from 'node:os';
+import path from 'node:path';
+import { fileURLToPath, pathToFileURL } from 'node:url';
+export const HERE = path.dirname(fileURLToPath(import.meta.url));
+const LAB = path.join(HERE, '..', '..', 'testlab', 'node_modules');
+export const { _electron: electron } = await import(pathToFileURL(path.join(LAB, 'playwright', 'index.mjs')).href);
+export const ELECTRON = path.join(LAB, 'electron', 'dist', process.platform === 'win32' ? 'electron.exe' : 'electron');
+export const GAME = process.env.GAME_URL || 'http://localhost:8123/';
+export const RUNS = process.env.CRACKLE_RUNS || path.join(os.tmpdir(), 'lba3-crackle');
diff --git a/lba3/tools/music/crackle/main.cjs b/lba3/tools/music/crackle/main.cjs
new file mode 100644
index 00000000..1bcce50a
--- /dev/null
+++ b/lba3/tools/music/crackle/main.cjs
@@ -0,0 +1,15 @@
+// Electron main for the crackle runs: the same Chromium switches as lba3/desktop/main.js (autoplay, playout stats,
+// GPU blocklist off, high-performance GPU, no background throttling), loading the worktree's game over http.
+const { app, BrowserWindow, session, desktopCapturer } = require('electron');
+app.commandLine.appendSwitch('autoplay-policy', 'no-user-gesture-required');
+app.commandLine.appendSwitch('enable-blink-features', process.env.LBA_BLINK || 'AudioContextPlayoutStats');
+app.commandLine.appendSwitch('ignore-gpu-blocklist');
+app.commandLine.appendSwitch('force_high_performance_gpu');
+app.whenReady().then(() => {
+  // LBA_LOOPBACK: getDisplayMedia gets the system's audio mix (WASAPI loopback: what Windows' mixer receives)
+  if (process.env.LBA_LOOPBACK) session.defaultSession.setDisplayMediaRequestHandler((req, cb) => { desktopCapturer.getSources({ types: [process.env.LBA_LOOPBACK === 'window' ? 'window' : 'screen'] }).then((s) => cb({ video: s[0], audio: 'loopback' })); });
+  const win = new BrowserWindow({ width: 1366, height: 768, useContentSize: true, backgroundColor: '#000000', autoHideMenuBar: true,
+    webPreferences: { contextIsolation: true, sandbox: true, backgroundThrottling: false } });
+  win.loadURL(process.env.LBA_URL || 'http://localhost:8123/?nocine');
+});
+app.on('window-all-closed', () => app.quit());
