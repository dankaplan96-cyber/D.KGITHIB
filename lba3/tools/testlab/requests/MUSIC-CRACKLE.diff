+for (let l = 0; l + M < sm.length; l++) { let s = 0, es = 0; for (let k = 0; k < M; k++) { s += cm[k] * sm[l + k]; es += sm[l + k] ** 2; } const r = s / Math.sqrt(ec * es + 1e-20); if (r > best) { best = r; bl = l; } }
