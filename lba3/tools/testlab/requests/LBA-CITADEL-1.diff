+  // the long wall's windows
+  k.at(2.3, 1.5, SZ0 + 0.02, 0, () => noticeBoard(k, 0.8, 0.55, 7));
+  k.add(rbox(0.14, 0.6, 1.6, 0.03), MAT.copper(), LX + 0.12, 0.45, -1.0);
