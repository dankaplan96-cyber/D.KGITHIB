+      R = R.map((r, k) => Math.max(r, Math.min(Rmax[k], r + 0.04 + hr() * 0.05)));
+      const [cx, cz] = off(y);
+      rings.push(ring.map((p, k) => { const a = Math.atan2(p[2] - cz, p[0] - cx); return [cx + Math.cos(a) * R[k], p[1] - 0.05 - hr() * 0.03, cz + Math.sin(a) * R[k]]; }));
