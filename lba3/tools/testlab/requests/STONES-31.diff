+  const Rt = ang.map(() => 1.13 + hr() * 0.09), Rb = Rt.map((r) => r + 0.13 + hr() * 0.06);
+  const top = ang.map((a, k) => [Math.cos(a) * Rt[k], -0.005 - hr() * 0.035, Math.sin(a) * Rt[k]]);
