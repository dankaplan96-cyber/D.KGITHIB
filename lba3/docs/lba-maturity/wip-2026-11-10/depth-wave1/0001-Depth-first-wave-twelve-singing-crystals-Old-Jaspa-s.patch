+    if (up && d < 1.5) consider(d, 1.6, { kind: 'dx_way', x: Y.cx, z: Y.cz, label: f.dx_way_seen && !f.dx_way_open ? 'p_turn' : 'p_look' });
+    else if (!up && d < 3.2) consider(d, 3.3, { kind: 'dx_way_look', x: Y.cx, z: Y.cz, label: 'p_look' });
