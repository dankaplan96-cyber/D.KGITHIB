+// the frame's look (no allocation a frame)
+const LOOK = key(90, { m: 0 });
+const lerpKey = (A, B, k, out) => {
+  for (const f of ['m', 'sunK', 'hemiK', 'fogK', 'scat', 'hfog', 'stars', 'lamps', 'moonK', 'glow2']) out[f] = A[f] + (B[f] - A[f]) * k;
