+// LIGHTING-145 (P145, the user 27.11: lighting like a fan's LBA2 editor shots, "really impressive, truly dynamic
+// lighting"). A candidate behind a URL switch, OFF by default: without `?light=dyn` this module changes nothing — no
+// shader text, no uniform, no light, no object — and the picture is exactly as before.
+//
+//   ?light=dyn                 the dynamic lighting: a time of day (sun and moon that move, the sky's gradient, the sun's
+//                              disc and glow, stars and Twinsun's Emerald Moon at night, clouds lit by the sun, fog colour,
+//                              height mist and sun scattering by the hour), lamps / lanterns / fires / crystals / glowing
+//                              signs that light up at dusk (glow + a real pool of light on the ground, the walls and the
+//                              people: the light pool's nearest-N with fades), windows glowing at night, a little flicker
+//                              on flames, the rooms' own lamps taking over from the daylight at night, wet ground in rain
+//                              (darker, glossy, puddles in a noise of low spots, ripples on High, the sky and the lamps
+//                              reflected), and a slow drying after.
+//   ?tod=noon|sunset|dusk|night|dawn|golden    pins the time (the sheets; story moments use LD.pin)
+//   ?todcycle=dusk             the cycle never goes past deep dusk (weather.js's standing rule "no night on Twinsun", the
+//                              user's of 2.11: the lamps still come on in the blue hour)
+//   ?todmin=<minutes>          the length of a day (default 24)
+//
+// Twinsun's night is not an Earth night: the sky stays a deep blue with the other sun's violet afterglow low on the
+// opposite horizon, the Emerald Moon (LBA2's green moon) gives a cool green-white light, and the ground stays readable.
+// Zeelich keeps its pale grey-lavender by day and goes rose-violet at sunset and indigo-violet at night.
+//
+// Quality (the 60 fps rule, P137): the tier follows the light pool's size, so it moves with Auto's profiles and the
+// presets in both directions (High 8 lamps · Medium 4 · Medium-lean / CPU-eco / Low 2). Every tier keeps the time of day,
+// the sky, the mist and the glow (halos drawn as one batch of sprites; High adds the bloom it already has). High: wet
+// reflections with puddles and ripples, 8 lamp pools; Medium: wet gloss and the sky's reflection, no puddles, 4 pools;
+// Low / CPU-eco: no reflections (the ground only darkens), 2 pools. Tiers are uniforms: no program is made by a switch.
+// No light is added (the one directional light is the sun by day and the moon by night; the pool keeps its size), so
+// the programs are the ones the game already makes, with the patched chunks.
+import * as THREE from 'three';
+
+const Q = typeof location !== 'undefined' ? location.search : '';
+const arg = (k) => (new RegExp(`[?&]${k}=([\\w.-]+)`).exec(Q) || [])[1];
+const TOD_PIN = arg('tod');
+export const LD = {
+  on: /[?&]light=dyn\b/.test(Q),
+  duskOnly: arg('todcycle') === 'dusk',
+  dayMin: +(arg('todmin') || 24),
+  theta: 0,              // the sun's angle on its circle: 0 noon, ±THSET at the horizon, π midnight
+  pinned: null,          // a pinned time's name (?tod=, LD.pin)
+  holds: new Map(),
+  night: 0, dusk: 0, sunElev: 52, tier: 'high', wet: 0,
+  stats: { frameMs: 0, sites: 0, halos: 0, sunSteps: 0, n: 0, sum: 0 },
+};
+if (typeof window !== 'undefined') window.__ld = LD;
+
+// ------------------------------------------------------------------------------------------------ the sun's circle
+// Noon is today's sun exactly (environment.js SUN_CITADEL: from the south-west, high); it sets low towards +z, over the
+// sea behind the lighthouse seen from the harbour, and rises on the other side. The light's direction never goes under
+// LIGHT_MIN° (long low shadows over the whole box and acne at grazing angles otherwise): the disc drawn in the sky does.
+const NOON = new THREE.Vector3(-0.5, 0.8, 0.35).normalize();
+const SET = new THREE.Vector3(-0.25, 0, 1).normalize();
+const V = SET.clone().addScaledVector(NOON, -SET.dot(NOON)).normalize();
+const THSET = Math.atan2(NOON.y, -V.y);   // (cos θ · NOON.y + sin θ · V.y = 0)
+const D2R = Math.PI / 180, LIGHT_MIN = 11 * D2R;
+export const sunAt = (th, out = new THREE.Vector3()) => out.copy(NOON).multiplyScalar(Math.cos(th)).addScaledVector(V, Math.sin(th));
+// named times: the sun's elevation they stand for (deg; negative: under the horizon), on the setting side unless dawn
+const NAMED = { noon: 0, golden: THSET - 9 * D2R, sunset: THSET - 2.6 * D2R, dusk: THSET + 6 * D2R, night: Math.PI, dawn: -(THSET - 3 * D2R) };
+const wrap = (a) => { a = (a + Math.PI) % (2 * Math.PI); if (a < 0) a += 2 * Math.PI; return a - Math.PI; };
+LD.thetaOf = (name) => NAMED[name];
+LD.setTime = (name) => { if (NAMED[name] != null) LD.theta = wrap(NAMED[name]); };
+LD.pin = (name, why = 'story') => { if (NAMED[name] == null) return; LD.holds.set(why, name); };
+LD.release = (why = 'story') => { LD.holds.delete(why); };
+if (TOD_PIN && NAMED[TOD_PIN] != null) { LD.pinned = TOD_PIN; LD.theta = wrap(NAMED[TOD_PIN]); }
+
+// ------------------------------------------------------------------------------------------------ the palettes
+// keys by the sun's elevation (deg), one table for the evening (and night), one for the morning. m: how far the frame
+// is taken from today's palette (0: today's colours exactly); the rest absolute (colours) or multipliers (K).
+const C = (h) => new THREE.Color(h);
+const key = (e, o) => ({ e, m: 1, sunK: 1, hemiK: 1, fogK: 1, scat: 0, hfog: 0, stars: 0, lamps: 0, moonK: 0, glow2: 0, ...o,
