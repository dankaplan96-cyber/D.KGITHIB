+  key(22, { m: 0.2, sun: '#fff0e4', fog: '#e0d6e6', scat: 0.12, scatCol: '#ffe4ec', zenith: '#8a8ac8' }),
+  key(40, { m: 0 }), key(90, { m: 0 }),
