+LD.frame = (game, dt) => {
+  if (!LD.on) return;
+  const t0 = performance.now();
+  const n = game.lightPool?.lights.length ?? 8;
+  LD.tier = n >= 8 ? 'high' : n >= 4 ? 'medium' : 'low';
+  const env = game.env, inside = !!env.interior, W = env.wx, L = LD.look;
+  // wet: up with the rain over ~25 s, dry over ~3 min (Citadel's rain and storm; never indoors)
+  const rain = inside || env.region ? 0 : Math.max(env.storm || 0, W?.on ? W.rain : 0);
+  const tgt = Math.min(1, rain * 1.15);
+  LD.wet += (tgt - LD.wet) * Math.min(1, (dt || 0) / (tgt > LD.wet ? 25 : 180));
+  const w = U.ldWet.value, wet = inside ? 0 : LD.wet;
+  w[0] = wet; w[1] = LD.tier === 'low' ? 0 : LD.tier === 'medium' ? 0.55 : 1; w[2] = LD.tier === 'high' ? 1 : 0; w[3] = game.time || 0;
+  const fc = env.fog.color, z = env.skyU?.uZenith?.value || fc;
+  w[4] = fc.r; w[5] = fc.g; w[6] = fc.b; w[7] = LD.tier === 'low' ? 0 : 1;
+  w[8] = z.r; w[9] = z.g; w[10] = z.b;
+  // windows glow at night
+  if (LD.windows) for (const m of LD.windows) m.emissiveIntensity = (m.userData.ldWin || 0) + 0.75 * (L?.lamps ?? 0);
+  updateHalos(game, game.time || 0);
+  // the frame's colour (the mood): over the area's own grade
+  if (L && !inside) { const m = L.m; game.renderer?.setLightTint?.(1 + (L.tint.x - 1) * m, 1 + (L.tint.y - 1) * m, 1 + (L.tint.z - 1) * m); }
+  else if (inside) game.renderer?.setLightTint?.(1 + 0.03 * LD.night, 1, 1 - 0.04 * LD.night);
+  const ms = performance.now() - t0 + (LD.stats.applyMs || 0);
+  const S = LD.stats; S.frameMs = ms; S.n++; S.sum += ms;
+};
+LD.info = () => ({ on: LD.on, theta: +LD.theta.toFixed(4), sunElev: +LD.sunElev.toFixed(2), night: +LD.night.toFixed(3), dusk: +LD.dusk.toFixed(3), tier: LD.tier, wet: +LD.wet.toFixed(3), planet: LD.planet,
+  pinned: LD.pinned, holds: [...LD.holds.keys()], sites: LD.stats.sites, halos: LD.stats.halos, sunSteps: LD.stats.sunSteps, msAvg: LD.stats.n ? +(LD.stats.sum / LD.stats.n).toFixed(4) : 0, collectMs: +(LD.stats.collectMs || 0).toFixed(1) });
