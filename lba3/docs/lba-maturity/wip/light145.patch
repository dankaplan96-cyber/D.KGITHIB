+  key(8, { m: 0.75, sunK: 0.9, sun: '#ffb466', hemiSky: '#e4c6c2', hemiGround: '#6a5048', hemiK: 0.86, fog: '#ecbc94', fogK: 0.92, scat: 0.45, scatCol: '#ffb064', hfog: 0.004, zenith: '#5878b8', cloud: '#ffd0a2', lamps: 0.15, tint: [1.06, 0.99, 0.9], sea: [1.0, 0.8, 0.68] }),
+  key(22, { m: 0.25, sunK: 1, sun: '#ffe2bc', hemiSky: '#d6dcf0', hemiGround: '#77745a', fog: '#c4d6ec', scat: 0.15, scatCol: '#ffe0b0', hfog: 0.003, zenith: '#4a86d0', cloud: '#fff2e2', tint: [1.02, 1, 0.97] }),
+  key(40, { m: 0 }),
+  key(90, { m: 0 }),
+];
+const TW_MORN = [
+  TW_EVE[0], TW_EVE[1],
+  key(-5, { m: 1, sunK: 0, moonK: 0.25, hemiSky: '#7a7cb8', hemiGround: '#2e3040', hemiK: 0.86, fog: '#6a6c96', fogK: 0.75, scat: 0.4, scatCol: '#e8a0a0', hfog: 0.012, zenith: '#22306a', cloud: '#6a6280', stars: 0.3, lamps: 1, glow2: 0.5, tint: [0.98, 0.97, 1.05], sea: [0.4, 0.4, 0.52] }),
+  key(1.5, { m: 1, sunK: 0.6, sun: '#ffa078', hemiSky: '#b0aad4', hemiGround: '#4c4858', hemiK: 0.86, fog: '#e6b4b4', fogK: 0.7, scat: 0.55, scatCol: '#ffc4a4', hfog: 0.014, zenith: '#5068a8', cloud: '#ffc0b0', lamps: 0.6, tint: [1.04, 0.98, 0.98], sea: [0.95, 0.85, 0.86] }),
+  key(8, { m: 0.7, sunK: 0.88, sun: '#ffd2a8', hemiSky: '#d0d4ee', hemiGround: '#686452', fog: '#e4d4d8', fogK: 0.8, scat: 0.3, scatCol: '#ffe0c8', hfog: 0.009, zenith: '#5a84c8', cloud: '#fff0ea', lamps: 0.1, tint: [1.02, 1, 1] }),
+  key(22, { m: 0.25, sun: '#fff0dc', fog: '#c8dcf0', fogK: 0.92, scat: 0.12, hfog: 0.003, zenith: '#4c8ad2' }),
+  key(40, { m: 0 }), key(90, { m: 0 }),
+];
+// Zeelich: its pale grey-lavender day kept; a rose-violet sunset, an indigo-violet night (its pink-violet identity)
+const ZE_EVE = [
+  key(-90, { m: 1, sunK: 0, moonK: 1, hemiSky: '#6a5aa8', hemiGround: '#241c34', hemiK: 0.64, fog: '#2c2250', fogK: 0.9, scat: 0.3, scatCol: '#9a7ab8', hfog: 0.005, zenith: '#120a30', cloud: '#3a2c52', stars: 1, lamps: 1, tint: [1.0, 0.95, 1.1], sea: [0.4, 0.34, 0.6] }),
+  key(-14, { m: 1, sunK: 0, moonK: 1, hemiSky: '#6a5aa8', hemiGround: '#241c34', hemiK: 0.64, fog: '#2c2250', fogK: 0.9, scat: 0.3, scatCol: '#9a7ab8', hfog: 0.005, zenith: '#120a30', cloud: '#3a2c52', stars: 1, lamps: 1, tint: [1.0, 0.95, 1.1], sea: [0.4, 0.34, 0.6] }),
+  key(-5, { m: 1, sunK: 0, moonK: 0.25, hemiSky: '#8a6ab0', hemiGround: '#30243a', hemiK: 0.86, fog: '#5a4278', fogK: 0.85, scat: 0.45, scatCol: '#e47aa0', hfog: 0.006, zenith: '#2a1c58', cloud: '#6a4c78', stars: 0.35, lamps: 1, tint: [1.02, 0.95, 1.06], sea: [0.6, 0.5, 0.72] }),
+  key(1.5, { m: 1, sunK: 0.62, sun: '#ff7a6a', hemiSky: '#c88ab0', hemiGround: '#4c3046', hemiK: 0.82, fog: '#d48cac', fogK: 0.86, scat: 0.6, scatCol: '#ff9aa0', hfog: 0.007, zenith: '#4c3c8a', cloud: '#f8a0b4', lamps: 0.75, tint: [1.07, 0.95, 0.98], sea: [1.0, 0.75, 0.85] }),
