diff --git a/lba3/tools/lighting145-sheet.py b/lba3/tools/lighting145-sheet.py
new file mode 100644
index 00000000..3951f790
--- /dev/null
+++ b/lba3/tools/lighting145-sheet.py
@@ -0,0 +1,61 @@
+#!/usr/bin/env python3
+# LIGHTING-145: the user's sheets from tools/lighting145-shots.mjs's pictures.
+#   python3 tools/lighting145-sheet.py <shots dir> <out dir>
+# sheet-1 Citadel's square and the harbour lighthouse (today / noon / sunset / night / rain at night), sheet-2 Zeelich and
+# Desert Island (today / sunset / night / dawn or dusk), sheet-3 Twinsen's house and the tavern (today / night).
+# Each sheet at most 1300 px wide and 3500 px tall; tiles 640 x 360 in two columns with a caption over each.
+import sys, os
+from PIL import Image, ImageDraw, ImageFont
+
+SRC, OUT = sys.argv[1], sys.argv[2]
+os.makedirs(OUT, exist_ok=True)
+TW, TH, CAP, PAD = 640, 360, 26, 6
+W = 2 * TW + 3 * PAD
+try:
+    FONT = ImageFont.truetype('/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf', 17)
+    TFONT = ImageFont.truetype('/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf', 20)
+except OSError:
+    FONT = TFONT = ImageFont.load_default()
+
+def tile(name):
+    for ext in ('.jpg', '.png'):
+        p = os.path.join(SRC, name + ext)
+        if os.path.exists(p):
+            return Image.open(p).convert('RGB').resize((TW, TH), Image.LANCZOS)
+    im = Image.new('RGB', (TW, TH), (40, 40, 40)); ImageDraw.Draw(im).text((20, 20), 'missing: ' + name, fill=(220, 80, 80), font=FONT); return im
+
+def sheet(fname, title, rows):
+    H = 40 + sum(TH + CAP + PAD for _ in rows) + PAD
+    assert W <= 1300 and H <= 3500, (W, H)
+    S = Image.new('RGB', (W, H), (24, 24, 28)); d = ImageDraw.Draw(S)
+    d.text((PAD + 4, 10), title, fill=(240, 240, 240), font=TFONT)
+    y = 40
+    for row in rows:
+        for i, cell in enumerate(row):
+            if not cell: continue
+            name, cap = cell
+            x = PAD + i * (TW + PAD)
+            d.text((x + 4, y + 4), cap, fill=(230, 230, 230), font=FONT)
+            S.paste(tile(name), (x, y + CAP))
+        y += TH + CAP + PAD
+    S.save(os.path.join(OUT, fname), optimize=True)
+    print(fname, S.size)
+
+sheet('sheet-1.png', 'Citadel at noon, sunset, night and rain at night (?light=dyn) - top left is the game today', [
+    [('square-today', 'Square - today (no switch)'), ('square-noon', 'Square - noon (?light=dyn)')],
+    [('square-sunset', 'Square - sunset'), ('square-night', 'Square - night')],
+    [('square-rainnight', 'Square - rain at night (wet ground)'), ('square-night-low', 'Square - night, Low quality')],
+    [('harbour-today', 'Harbour and lighthouse - today'), ('harbour-noon', 'Harbour and lighthouse - noon')],
+    [('harbour-sunset', 'Harbour - sunset over the sea'), ('harbour-night', 'Harbour - night')],
+    [('harbour-rainnight', 'Harbour - rain at night'), ('square-dawn', 'Square - dawn haze')],
+])
+sheet('sheet-2.png', 'Zeelich and Desert Island at sunset and night (?light=dyn)', [
+    [('zeelich-today', 'Zeelich - today'), ('zeelich-sunset', 'Zeelich - sunset')],
+    [('zeelich-night', 'Zeelich - night'), ('zeelich-dusk', 'Zeelich - dusk')],
+    [('desert-today', 'Desert Island - today'), ('desert-sunset', 'Desert Island - sunset')],
+    [('desert-night', 'Desert Island - night'), ('desert-dawn', 'Desert Island - dawn')],
+])
+sheet('sheet-3.png', "Two rooms at night (?light=dyn): Twinsen's house and the tavern", [
+    [('house-today', "Twinsen's house - today"), ('house-night', "Twinsen's house - night")],
+    [('tavern-today', 'The tavern - today'), ('tavern-night', 'The tavern - night')],
+])
diff --git a/lba3/tools/lighting145-shots.mjs b/lba3/tools/lighting145-shots.mjs
new file mode 100644
index 00000000..d22dede6
--- /dev/null
+++ b/lba3/tools/lighting145-shots.mjs
@@ -0,0 +1,61 @@
+// LIGHTING-145: the pictures and renderer.info for the user's sheets (tools/lighting145-sheet.py) and the cost table.
+//   SERVE=1 MODE=today node tools/lighting145-shots.mjs <out dir>     the game as it is (no switch): <place>-today
+//   SERVE=1 MODE=dyn   node tools/lighting145-shots.mjs <out dir>     ?light=dyn&weather=1 at each place's hours
+//   ONLY=square,harbour  some places; INFO=1 also the 10-frame CPU time of the step + render (relative, this machine)
+// One browser, 1280 x 720, a new game, each place from the play camera (rooms and regions entered directly, no story).
+// Automated runtime only (SwiftShader): the pictures show the look; no number here is a GPU's.
+import { launch, open, menu } from '../tests/lib/boot.mjs';
+import fs from 'node:fs'; import path from 'node:path';
+const OUT = process.argv[2]; fs.mkdirSync(OUT, { recursive: true });
+const MODE = process.env.MODE || 'dyn', ONLY = process.env.ONLY?.split(',');
+// [name, placement, hours under ?light=dyn] — the hours: noon · sunset · dusk · night · dawn · rainnight (Citadel's
+// rain forced, the ground wet) · night-low (night at the Low preset: the tier with 2 lamps and no reflections)
+const PLACES = [
+  ['square', { x: -42, z: -2, a: 0.6 }, ['noon', 'sunset', 'night', 'rainnight', 'dawn', 'night-low']],
+  ['harbour', { x: -116, z: 46, a: 0.25 }, ['noon', 'sunset', 'night', 'rainnight']],
+  ['zeelich', { room: 'zeelich', t: 2 }, ['sunset', 'dusk', 'night']],
+  ['desert', { room: 'desert', t: 2 }, ['sunset', 'night', 'dawn']],
+  ['house', { room: 'house', t: 2.5 }, ['night']],
+  ['tavern', { room: 'tavern', t: 2.5 }, ['night']],
+];
+const { browser, page, errs } = await launch({ width: 1280, height: 720 });
+const ev = (f, a) => page.evaluate(f, a);
+await open(page, MODE === 'today' ? '?nocine' : '?nocine&light=dyn&weather=1');
+await menu(page, 'new');
+const res = {};
+const quality = (q) => ev((q) => { const G = game; if (G.settings.quality === q && !G.settings.qualityAuto) return; G.settings.qualityAuto = false; G.settings.quality = q; G.applySettings(); G.step(0.5); }, q);
+for (const [name, s, hours] of PLACES) {
+  if (ONLY && !ONLY.includes(name)) continue;
+  await ev((s) => { const G = game, h = G.hero;
+    if (s.room) G.enterRoom(s.room, s.x != null ? { x: s.x, z: s.z, a: s.a } : null, true, true);
+    else G.exitRoom({ x: s.x, z: s.z, a: s.a ?? 0 }, true, true);
+    if (s.a != null) h.angle = s.a;
+    G.camRig.lba && (G.camRig.lba.init = false); G.step(s.t ?? 1.5);
+  }, s);
+  for (const hour of MODE === 'today' ? ['today'] : hours) {
+    const low = hour.endsWith('-low');
+    await quality(low ? 'low' : 'high');
+    const r = await ev(async ({ hour, info }) => { const G = game, LD = window.__ld;
+      if (LD?.on) {
+        const rain = hour.startsWith('rain'), t = (rain ? hour.slice(4) : hour).replace(/-low$/, '') || 'night';
+        if (G.weather?.enabled()) { try { G.weather.force(rain ? 'rain' : 'clear', 0); } catch { /* (a region without that state) */ } }
+        LD.pinned = t; LD.setTime(t); LD.wet = rain ? 1 : 0; LD._haloT = -1;
+      }
+      G.step(0.25);
+      const R = G.renderer.renderer;
