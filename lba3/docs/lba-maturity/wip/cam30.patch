+      else { try { const pr = G.regions.probe(() => G.story.exitTo(e.to)); for (const m of pr.misses || []) G.regions.ensure(m, 'cam30'); to = G.story.exitTo(e.to); } catch (err) { continue; } }
+      if (!to || !Number.isFinite(to.x)) continue;
+      const reg = to.room || 'citadel'; if (reg !== area) continue;
+      const d = Math.hypot(to.x - w.x, to.z - w.z); if (d < 12 && (!best || d < best.d)) best = { e, d };
+    }
+    if (!best) return { skip: 'no exit back to it' };
+    for (const k of [...G.input.keys]) G.input.keys.delete(k);
+    for (let i = 0; i < 100 && (G.trans || G.state !== 'play'); i++) { if (G.state === 'dialog') G.input.taps.add('KeyE'); else if (G.state !== 'play' && G.state !== 'cinematic') G.setState('play'); G.step(0.1); }
