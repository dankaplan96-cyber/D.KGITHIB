+// CAM-30 (OPEN-TASKS #30, "two places where the camera goes into a wall"): the play camera against walls, game-wide.
+// camclear.mjs covers Citadel's cliffs and its ball targets; this suite walks every outdoor area — Citadel, Zeelich,
+// Desert Island and Kesh, the Hamalayi, the nine isles, Ballastra's harbour and its two districts — at the defaults
+// (Follow, Far — P100 —, Classic controls), Twinsen moved by input (tests/lib/player.js P.go, held keys) at 60 fps, every
+// camera update recorded (tests/lib/camwalk.js, tests/lib/camscan.js):
+//   legs   each resident's round, stop to stop (the residents' routes are the area's paths)
+//   doors  every door any chapter offers into the area: out of its room by input, recorded from the first frame
+//          outside, a walk away, a whole turn on the spot with his back to the house, a stand
+//   loops  round every building (the area's scenery volumes, touching pieces as one): its corners 1.0 m off the walls,
+//          a whole turn at the first corner, then round by input
+// The seeds are the game's own data, frozen in tests/fixtures/cam30-seeds.json on the first run (SEEDS=new builds
+// them again), so a fix that adds a camera volume does not change what is walked.
+// Per walk, judged (FAIL):
+//   - the lens in anything solid the camera knows (a collider, a scenery volume, the terrain: CW.inside)
+//   - the lens behind a drawn face of a wall-like solid (inside it)
+//   - the near plane (its middle and four corners, at cam.near in front of the lens) inside or within 0.15 m of a
+//     wall-like drawn solid: its inside shows, or it is about to
+//   - a wall-like drawn solid covering him (the lines to his head and his chest both cut) longer than 0.75 s
+//   (wall-like: the solid round the spot, measured by rays along x, y and z to its faces, has two extents of 1.5 m or
+//   more — a wall, a roof, a rock face, the ground; an eave's rim, a post, a rail, a branch has one)
+// Listed (not judged): the lens within 0.15 m of a wall-like solid but outside it (beside the lens, nothing it draws is
+// cut: the near plane's own test above says when it is), the same with smaller solids (NEAR-CUT, camera.js, cuts what stands within 1 m of the lens on
+// purpose: an eave's rim, a post, a branch), the camera's own sight test (colliders and volumes), and per walk its
+// largest heading step per 60th of a second and its arm rate (the before/after: the view no jumpier).
+// LEFT below: what stays, with its reason (printed, never dropped).
+// PART=out|in (in: every interior room, the fixed iso camera at each of its exits and its landing: his head and chest
+// against the room's own meshes, room-cutaway.mjs's rays); ONLY=<area id regex>; WALK=<walk name regex>; MAX=<walks per
+// kind per area>; OUT=<file.json> every walk's numbers; SHOTS=<dir> a picture at each judged walk's worst frame (Follow,
+// the play camera); SHOTFROM=<an OUT file> TAG=<before|after> no walks: a picture at each of that run's findings,
+// replayed to the same frame (before and after pictures of one moment). Per area it prints the cost of the near plane's
+// choice (camera.js _lens) and per walk the near plane's largest change a frame and its reversals (no flicker).
+// SERVE=1 answers this checkout's files by request routing. Automated runtime only (SwiftShader).
+import { launch, open, menu, checker } from './lib/boot.mjs';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+const { check, checkVisual, done } = checker({ info: 'always' });
+const SHOTFROM = process.env.SHOTFROM || '', TAG = process.env.TAG || '', ONLY = process.env.ONLY || '', WALK = process.env.WALK || '', MAX = +(process.env.MAX || 1e9), OUT = process.env.OUT || '', SHOTS = process.env.SHOTS || '', PART = process.env.PART || '';
+const SEEDF = fileURLToPath(new URL('./fixtures/cam30-seeds.json', import.meta.url));
+const iso = (s) => console.log('ISO  ' + s);
+const COV_S = 0.75;   // (wall-like: the solid's second largest extent ≥ 1.5 m, camscan.js CS.extent)
+// LEFT: [area, walk name regex, kind regex, reason]
+const LEFT = [];
+const leftFor = (area, name, kind) => LEFT.find(([a, n, k]) => a === area && new RegExp(n).test(name) && new RegExp(k).test(kind));
+
+const { browser, page } = await launch({ width: 960, height: 540 });
+const ev = (f, a) => page.evaluate(f, a);
+const t0 = Date.now();
+// (?allregions builds every area at the start: needed to gather the seeds; replaying frozen seeds, each area is built
+//  when a walk first goes there — the same areas, less memory on a shared machine)
+const seedsKnown = !process.env.SEEDS && fs.existsSync(SEEDF);
+await open(page, seedsKnown ? '?nocine' : '?nocine&allregions');
+await menu(page, 'new');
+await page.addScriptTag({ path: fileURLToPath(new URL('./lib/camwalk.js', import.meta.url)) });
+await page.addScriptTag({ path: fileURLToPath(new URL('./lib/camscan.js', import.meta.url)) });
+const setup = await ev(async () => {
+  const r0 = CW.setup(); const G = game;
+  G.settings.camDist = 'far'; G.settings.autoControls = 'off'; G.applySettings(); G.camRig.cut = false; G.hero.hasBall = true;
+  try { (await import('/src/engine/viewinst.js')).setViewInst(false); } catch (e) { /* (every instance in the triangle store) */ }
+  return { cam: G.settings.camera, dist: G.settings.camDist, controls: G.settings.controls, state: G.state, follow: G.camRig.mode };
+});
+iso((seedsKnown ? 'each area built when a walk first goes there' : 'every outdoor area built at the start (?allregions)') + '; a new game, the prologue done (flags); Twinsen put at each walk\'s start (CW.place), then moved by input');
+check('the defaults: Follow camera, Far (P100), Classic controls', setup.cam === 'follow' && setup.dist === 'far' && setup.controls === 'classic', setup);
+console.log('boot', ((Date.now() - t0) / 1000).toFixed(0), 's');
+
+// ---------------------------------------------------------------- the seeds (frozen)
+let SEEDS = !process.env.SEEDS && fs.existsSync(SEEDF) ? JSON.parse(fs.readFileSync(SEEDF, 'utf8')) : null;
+if (!SEEDS) {
+  SEEDS = {};
