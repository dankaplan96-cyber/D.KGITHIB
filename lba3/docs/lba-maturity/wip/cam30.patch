+++ b/lba3/tests/lib/camscan.js
@@ -0,0 +1,308 @@
+// CAM-30, page side (tests/camwalls.mjs loads it after tests/lib/player.js and tests/lib/camwalk.js). camwalk.js records
+// every camera update (CW.F: the arm, what solid the lens stands in, the nearest drawn surface, behind a face, the
+// near-plane cut, his sight by colliders and volumes); this file adds, on the same frames:
+//   np    the camera's near plane itself: five points of its rectangle (the middle, the four corners) at cam.near in
+//         front of the lens — the least distance from them to a drawn surface, and whether one of them stands behind
+//         a one-sided face (the near plane inside a closed mesh: the inside of a wall shows); with its piece's name and
+//         size (the largest side of the mesh's box: an eave's rim or a post is small, a wall or a cliff large)
+//   cov   a drawn surface covers him: the lines from the lens to his head (1.5 m) and to his chest (1.0 m) both cut by a
+//         drawn opaque triangle beyond the near plane (what NEAR-CUT leaves out is not drawn) and short of him (0.35 m)
+//   sil   the silhouette pass draws him (characters.js) at that frame
+// CS.seeds(area)  the area's walks, from the game's own data (frozen by the runner into a fixture on the first run):
+//   legs   each resident's round, stop to stop (walkers.js), Twinsen walked along it by input (P.go)
+//   doors  every door the story offers into the area (any chapter): out of its room by input (P.through), recorded from
+//          the first frame outside, then a walk away, a whole turn on the spot (his back to the house), a stand
+//   loops  round every building (the area's scenery volumes made into footprints, pieces that touch as one): its
+//          corners 1.0 m off its walls walked round by input, a whole turn at the first corner
+(() => {
+  const G = window.game, C = G.camRig, cam = G.camera, PH = G.physics, CW = window.CW;
+  const V3 = cam.position.constructor;
+  const CS = (window.CS = {});
+  const _a = new V3(), _b = new V3(), _d = new V3(), _e1 = new V3(), _e2 = new V3(), _p = new V3(), _q = new V3(), _t = new V3();
+
+  // ------------------------------------------------------------------ areas
+  CS.areas = () => ['citadel', ...Object.entries(G.rooms).filter(([, R]) => R.outdoor).map(([id]) => id)];
+  const spawnOf = (id) => (id === 'citadel' ? { x: -42, z: 8 } : G.rooms[id].spawn || G.rooms[id].center);
+  CS.areaOf = (x, z) => { if (Math.abs(x) < 300 && Math.abs(z) < 300) return 'citadel'; let best = null, bd = 260; for (const id of CS.areas()) { if (id === 'citadel') continue; const s = spawnOf(id); const d = Math.hypot(s.x - x, s.z - z); if (d < bd) { bd = d; best = id; } } return best; };
+  CS.enter = (id, at = null) => { const s = at || spawnOf(id); return CW.place({ room: id === 'citadel' ? undefined : id, x: s.x, z: s.z, a: s.a ?? 0 }); };
+  const occOf = (id) => (id === 'citadel' ? G.world.occ : G.rooms[id]?.occ) || null;
+  const standable = (x, z, ref = null) => {
+    const g = ref == null ? PH.groundAt(x, z) : PH.groundAt(x, z, ref + 1.2);
+    if (!Number.isFinite(g) || g < -0.3 || PH.blockedAt(x, z, g + 0.3, 0.35) || PH.steepAt?.(x, z, g)) return null;
+    if (ref != null && Math.abs(g - ref) > 1.6) return null;
+    return g;
+  };
+
+  // ------------------------------------------------------------------ seeds
+  // every door the story offers in each chapter (by its flags, as door-sweep.mjs sets them), then the flags as they were
+  CS.collectDoors = () => {
+    const S = G.story, f = G.flags, keep = { chapter: f.chapter, chapterKey: f.chapterKey }, out = [];
+    for (let ci = 0; ci < S.chapters.length; ci++) {
+      Object.assign(f, { chapter: ci, chapterKey: S.chapters[ci].key });
+      try { S.refreshCast?.(); out.push(...S.doors()); } catch (e) { /* a chapter that needs more of its flags */ }
+    }
+    Object.assign(f, keep); S.refreshCast?.(); P.settle();
+    CS.allDoors = out.filter((d) => d && Number.isFinite(d.x));
+    return CS.allDoors.length;
+  };
+  CS.seeds = (id) => {
+    const out = { legs: [], doors: [], loops: [] };
