+#!/usr/bin/env python3
+# CAM-30: the before/after sheet of camwalls.mjs's pictures (SHOTFROM=<base OUT> TAG=before / TAG=after, one directory).
+# usage: python3 tools/cam30-sheet.py <shots dir> <out.png> <name> [<name> ...]
+#   each <name> is a picture's name without its before-/after- prefix (e.g. isle-platform-building-3-...-nearplane.png);
+#   rows of before | after, 600 px wide each (scaled from 960 x 540), a caption over each row; at most 1300 x 3500 px.
+import sys
+from PIL import Image, ImageDraw, ImageFont
+
+src, out, names = sys.argv[1], sys.argv[2], sys.argv[3:]
+W, H, CAP, GAP = 640, 360, 24, 6
+rows = []
+for n in names:
+    try:
+        a = Image.open(f'{src}/before-{n}').convert('RGB').resize((W, H))
+        b = Image.open(f'{src}/after-{n}').convert('RGB').resize((W, H))
+    except FileNotFoundError:
+        continue
+    rows.append((n, a, b))
+h = min(3500, len(rows) * (H + CAP + GAP) + CAP)
+sheet = Image.new('RGB', (2 * W + GAP, h), (24, 24, 24))
+d = ImageDraw.Draw(sheet)
+try:
+    font = ImageFont.truetype('/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf', 15)
+except OSError:
+    font = ImageFont.load_default()
+d.text((8, 4), 'CAM-30: before (left) | after (right): Follow, Far; automated runtime only (SwiftShader)', fill=(235, 235, 235), font=font)
+y = CAP
+for n, a, b in rows:
+    if y + CAP + H > h:
+        break
+    d.text((8, y + 3), n.replace('.png', '').replace('-', ' '), fill=(255, 220, 120), font=font)
+    sheet.paste(a, (0, y + CAP)); sheet.paste(b, (W + GAP, y + CAP))
+    y += CAP + H + GAP
+sheet.save(out, optimize=True)
+print(out, sheet.size, len(rows), 'rows')
