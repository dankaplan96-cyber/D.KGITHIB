+    return { r: 'out' };
+  };
+  CS.loop = (w) => {
+    const p = w.pts; if (p.length < 2) return { skip: 'short' };
+    CW.place({ x: p[0][0], z: p[0][1], a: Math.atan2(p[1][0] - p[0][0], p[1][1] - p[0][1]), room: w.room });
