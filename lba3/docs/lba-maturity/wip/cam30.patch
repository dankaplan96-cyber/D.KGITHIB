+    hold(['ArrowLeft'], 3.6);
+    const res = [];
+    for (let i = 1; i <= p.length; i++) { const q = p[i % p.length]; const r = P.go(q[0], q[1], { tol: 0.7, maxT: 14, fight: false }); res.push(r.r); keepAlive(); }
+    hold([], 0.6);
+    return { r: res.join(',') };
+  };
+})();
