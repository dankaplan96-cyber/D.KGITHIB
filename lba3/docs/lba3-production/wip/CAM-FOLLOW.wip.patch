+import { launch, open, menu } from '../../tests/lib/boot.mjs';
+const { browser, page } = await launch({ width: 640, height: 360 });
+await open(page, '?nocine'); await menu(page, 'new');
+console.log(await page.evaluate(() => {
+  const G = game, P = G.physics; for (let i = 0; i < 80 && G.state !== 'play'; i++) { G.input.taps.add('KeyE'); G.step(0.05); }
+  const L = P.colliders; const st = { n: L.length, room: G.room?.id, types: {} };
+  for (const c of L) { const k = c.type + (c.camSkip ? '/skip' : '') + (c.fades ? '/fades' : '') + (c.enabled ? '' : '/off'); st.types[k] = (st.types[k] || 0) + 1; }
+  st.sample = L.filter((c) => c.type !== 'cyl').slice(0, 8).map((c) => ({ x: c.x, z: c.z, hw: c.hw, hd: c.hd, top: c.top, bottom: c.bottom, g: P.groundAt(c.x, c.z), skip: c.camSkip }));
+  st.tall = L.filter((c) => c.type !== 'cyl' && c.enabled && c.top - P.groundAt(c.x, c.z) > 4).length;
+  st.big = L.filter((c) => c.type !== 'cyl' && c.enabled && c.hw >= 1.5 && c.hd >= 1.5).length;
