@@ -0,0 +1,26 @@
+// CPU cost of CameraRig.update per frame (JS only; headless Chromium, SwiftShader GL — not a GPU number)
+import { launch, open, menu } from '../../tests/lib/boot.mjs';
+const { browser, page } = await launch({ width: 960, height: 540 });
+await open(page, '?nocine'); await menu(page, 'new');
+const r = await page.evaluate(() => {
+  const G = game, h = G.hero, C = G.camRig, I = G.input;
+  for (let i = 0; i < 80 && G.state !== 'play'; i++) { I.taps.add('KeyE'); G.step(0.05); }
+  Object.assign(G.flags, { prologueDone: true, intro: true });
+  const up = C.update.bind(C); let tot = 0, n = 0, max = 0;
+  C.update = (...a) => { const t0 = performance.now(); up(...a); const d = performance.now() - t0; tot += d; n++; max = Math.max(max, d); };
+  const out = {};
+  for (const m of ['lba', 'follow']) {
+    G.settings.camera = m; G.applySettings(); C.cut = false;
+    const spots = [[-38, 4, Math.PI], [-55, 19.2, Math.PI / 2], [-44.6, 28.4, 0]];
+    tot = 0; n = 0; max = 0;
+    for (const [x, z, a] of spots) {
+      G.exitRoom({ x, z, a }, true, true); G.step(0.5);
+      I.keys.add('ArrowUp'); for (let i = 0; i < 120; i++) { if (i % 40 === 20) I.keys.add('ArrowLeft'); if (i % 40 === 35) I.keys.delete('ArrowLeft'); G.frame(1 / 60, false); } I.keys.clear();
+      for (let i = 0; i < 60; i++) G.frame(1 / 60, false);
+    }
+    out[m] = { frames: n, meanMs: +(tot / n).toFixed(3), maxMs: +max.toFixed(2) };
+  }
+  return out;
+});
+console.log(JSON.stringify(r));
+await browser.close();
