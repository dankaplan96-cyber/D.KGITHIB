+  G.exitRoom({ x: -84, z: -80, a: Math.PI / 2 }, true, true); G.step(0.3);
+  h.pos.set(-84, P.groundAt(-84, -80), -80); h.angle = Math.PI / 2; h.resetMotion(); C.snap(); G.step(1); h.behaviour = 'athletic';
