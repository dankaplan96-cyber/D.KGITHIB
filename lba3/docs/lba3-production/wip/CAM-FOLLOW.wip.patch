+++ b/lba3/scratchpad/camfollow/probe.mjs
@@ -0,0 +1,46 @@
+// scratch probe for CAM-FOLLOW: numbers and a few frames
+import { launch, open, menu } from '../../tests/lib/boot.mjs';
+import path from 'node:path';
+const OUT = process.env.OUT || 'scratchpad/camfollow/probe';
+import fs from 'node:fs'; fs.mkdirSync(OUT, { recursive: true });
+const { browser, page } = await launch({ width: 960, height: 540 });
+const ev = (f, a) => page.evaluate(f, a);
+await open(page, '?nocine');
+await menu(page, 'new');
+await ev(() => {
+  const G = game, I = G.input, h = G.hero, C = G.camRig, dt = 1 / 60;
+  for (let i = 0; i < 80 && G.state !== 'play'; i++) { I.taps.add('KeyE'); G.step(0.05); }
+  Object.assign(G.flags, { prologueDone: true, intro: true });
+  const deg = (a) => (a * 180) / Math.PI, ad = (a, b) => Math.atan2(Math.sin(b - a), Math.cos(b - a));
+  window.F = {
+    off() { return +deg(ad(C.yaw, h.angle + Math.PI)).toFixed(1); },
+    place(x, z, a) { G.exitRoom({ x, z, a }, true, true); G.step(0.3); h.pos.set(x, G.physics.groundAt(x, z), z); h.angle = a; h.resetMotion(); C.snap(); for (let t = 0; t < 1; t += dt) G.frame(dt, false); },
+    hold(keys, s, rec) { for (const k of keys) { I.keys.add(k); I.taps.add(k); } for (let t = 0; t < s - 1e-9; t += dt) { G.frame(dt, false); rec?.(); } for (const k of keys) I.keys.delete(k); },
+    cam(m) { G.settings.camera = m; G.applySettings(); C.cut = false; },
+  };
+  F.cam('follow');
+});
+const r = await ev(() => {
+  const out = {}, h = game.hero, C = game.camRig;
+  F.place(-84, -80, Math.PI / 2);
+  out.start = { off: F.off(), pitch: C.pitch, dist: C.dist, cam: game.camera.position.toArray().map((v) => +v.toFixed(2)), hero: h.pos.toArray().map((v) => +v.toFixed(2)) };
+  // turn on the spot 90° left, then stand and watch the offset
+  const tr = []; let t = 0;
+  F.hold(['ArrowLeft'], 0.9, () => { t += 1 / 60; if (Math.round(t * 60) % 6 === 0) tr.push([+t.toFixed(2), F.off()]); });
+  F.hold([], 0.8, () => { t += 1 / 60; if (Math.round(t * 60) % 6 === 0) tr.push([+t.toFixed(2), F.off()]); });
+  out.turn = tr;
+  // walk backward 2 s
+  const y0 = C.yaw; F.hold(['ArrowDown'], 2); out.back = { turned: +(Math.abs(y0 - C.yaw) * 57.3).toFixed(2), off: F.off() };
+  return out;
+});
+console.log(JSON.stringify(r, null, 1));
+await ev(() => { F.place(-38, 4, Math.PI); game.frame(1 / 60, true); });
+await page.screenshot({ path: path.join(OUT, 'street-0.png') });
+await ev(() => { game.input.keys.add('ArrowUp'); for (let i = 0; i < 90; i++) game.frame(1 / 60, false); game.frame(1 / 60, true); });
+await page.screenshot({ path: path.join(OUT, 'street-1.png') });
+await ev(() => { game.input.keys.add('ArrowLeft'); for (let i = 0; i < 40; i++) game.frame(1 / 60, false); game.frame(1 / 60, true); });
+await page.screenshot({ path: path.join(OUT, 'street-2.png') });
+await ev(() => { game.input.keys.delete('ArrowLeft'); for (let i = 0; i < 60; i++) game.frame(1 / 60, false); game.frame(1 / 60, true); });
+await page.screenshot({ path: path.join(OUT, 'street-3.png') });
+await ev(() => { game.input.keys.clear(); });
+await browser.close();
