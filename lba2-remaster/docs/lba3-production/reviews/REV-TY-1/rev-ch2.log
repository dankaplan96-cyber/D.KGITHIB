start: {"state":"play","room":"citadel","pos":[-40.2,2.2,-5.6],"hp":10,"chapter":"project","obj":"Tell Zoé what happened in the well (home, Bug Street)","items":[],"coins":4,"clovers":3,"l":{}}
nell first: {"r":"talked","to":"nell","state":"play","lines":4}
nell first lines: ["n_nell: Arthur's dad, right? He still owes me a sprocket.","n_nell: Esmer engines are wonderful machines. Try getting a spare part for one, though. Three weeks, by shuttle."]
crate before odile: {"r":"used","open":false}
crate before odile lines: ["n_hero: An Esmer crate, \"SOUP POT (1)\". It hums.","n_hero: (Better ask at the customs booth first.)"]
odile: {"r":"talked","to":"odile","state":"play","lines":8}
odile lines: ["n_odile: Twinsen? The Twinsen? I pictured you taller. And with a cape.","n_hero: Just the tunic, I'm afraid.","n_odile: That crate stays here. The form says soup pot. Soup pots don't hum.","n_odile: Find out what it really is and I'll file it properly. Properly is the important word."]
crate open: {"r":"used","open":true,"cs":"hand","items":["coupler"],"tag":"open"}
crate open lines: ["n_hero: Not a pot. A brass drum with fins, warm to the touch. Nell would know what this is.","TOAST l_toast_coupler"]
odile while carrying: {"r":"talked","to":"odile","state":"play","lines":2}
odile carrying lines: ["n_odile: A brass drum with fins. Kitchenware? Heating? Show me it does something and I'll pick a category."]
nell with coupler: {"r":"talked","to":"nell","state":"play","lines":4}
nell coupler lines: ["n_nell: Where did you get that? That's a heat coupler! My engine's been dead a month waiting for one.","n_nell: Set it on the bench. Careful, couplers run hot until they settle. When it glows, cool it in the water barrel. Quick."]
bench place: {"r":"used","cs":"bench","heat":0.031249999999999997}
bench place lines: ["n_hero: It catches... the engine turns. And it's getting warm."]
take too early: {"cs":"bench","heat":0.192}
take too early lines: ["n_hero: It's warming up. Not glowing yet."]
