bench settle: {"cs":"done","coupler":true}
bench settle lines: ["n_hero: Back on the bench. Warm, steady, humming.","n_nell: Hear that? She runs! I'll tell Xil it was his idea.","TOAST l_toast_engine"]
nell before clearing: {"r":"talked","paid":false,"coins":0}
nell before clearing lines: ["n_nell: She purrs now. Esmer engines purr, did you know?"]
odile clears: {"r":"talked","cleared":true,"tag":"cleared","barrier":1.2}
odile clears lines: ["n_odile: A heat coupler, tested on the quay by a qualified... what are you, exactly?","n_hero: Twinsen.","n_odile: ...by a Twinsen. Machinery, imported. Cleared. Tell Xil his soup is ready.","TOAST l_toast_cleared"]
nell pays: {"coins":[4,7],"spawned":0,"left":0}
nell pays lines: ["n_nell: Xil left a finder's fee. Don't spend it on sprockets."]
nell again: {"spawned":0}
nell again lines: ["n_nell: If the project's couplers run like this one, they'll need a lot of water."]
bram: {"r":"talked","to":"bram","state":"play","lines":8}
bram lines: ["n_bram: Twinsen! Just the man. The project ran its pipe right past my pump, and the handle seized the day they dug.","n_bram: Mira says the pipe makes the pump pointless. The figures look fine, she says. Figures don't carry buckets.","n_hero: I'll have a look at it.","n_bram: Mind the valve pin. It rusted in when they dug."]
pump no pliers: {"need":true,"journal":[{"key":"l_j_pump0","done":false},{"key":"l_j_pliers","done":false},{"key":"l_j_crate0","done":true},{"key":"l_j_crate1","done":true},{"key":"l_j_crate2","done":true}]}
pump no pliers lines: ["n_hero: The valve pin's rusted in. I need pliers. Mine have gone missing."]
boat box: {"pliers":true,"items":["pliers"]}
boat box lines: ["n_hero: Paint, string, a spare sail... and my pliers. Arthur.","TOAST l_toast_pliers"]
pump fix: {"pin":true,"presses":4,"strokes":3,"pump":true,"running":true,"items":[]}
pump fix lines: ["n_hero: Pin's out. Now the handle.","n_hero: There it goes. Cold and clear.","TOAST l_toast_pump"]
arthur after pliers found: {"r":"talked","to":"arthur","state":"play","lines":2}
arthur lines: ["n_arthur: Grandpa's radio is full of dust. What does this button do? Ow!"]
bram thanks: {"spawned":0,"clovers":[3,4],"left":0}
bram thanks lines: ["n_bram: Listen to that. Fifty years and it still sings. Pipes break, Twinsen. Pumps don't.","n_bram: Here. A four-leaf clover. I kept it for the day somebody listened.","TOAST toast_clover_found"]
bram again x3: [0,0,0]
bram again lines: ["n_bram: Saved the world twice and still answers the door. Good lad.","n_bram: Half the lane fills its kettle here again. Don't tell Mira.","n_bram: The new pipe is warm. Too warm, if you ask me. Nobody does."]
drink: {"hp":[5,8,10],"max":10,"note":"ISO: hp lowered to test the heal"}
drink lines: ["n_hero: Cold. Proper well water.","n_hero: Cold. Proper well water."]
