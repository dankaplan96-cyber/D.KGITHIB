{
  "name": "lba3-the-awakening",
  "productName": "LBA3 The Awakening",
  "version": "0.29.1",
  "description": "LBA3: The Awakening, an unofficial fan sequel to Little Big Adventure 2 (desktop build).",
  "author": "LBA3 fan project",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "game": "node copy-game.mjs",
    "start": "node copy-game.mjs && electron .",
    "dist:win": "node copy-game.mjs && electron-builder --win --publish never",
    "dist:mac": "node copy-game.mjs && electron-builder --mac --publish never",
    "dist:linux": "node copy-game.mjs && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "43.7.9",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "org.lba3fan.awakening",
    "productName": "LBA3 The Awakening",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "game/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "LBA3-The-Awakening-${version}-win.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "LBA3 The Awakening",
      "artifactName": "LBA3-The-Awakening-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.adventure-games",
      "artifactName": "LBA3-The-Awakening-${version}-mac.${ext}",
      "identity": null
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Game",
      "artifactName": "LBA3-The-Awakening-${version}-linux.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dankaplan96-cyber/geriatrics-course.git"
  }
}
